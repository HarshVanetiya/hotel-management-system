# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL). Use the *pooled* connection string from the Neon
# console for the app. Never commit real values.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.region.aws.neon.tech/hotel?sslmode=require"

# Optional: force a driver. "neon" = @neondatabase/serverless (WebSocket Pool),
# "pg" = node-postgres. Default: "neon" for *.neon.tech hosts, otherwise "pg".
# DATABASE_DRIVER="neon"

# Isolated database used ONLY by `npm test`. Its database name must contain
# "test"; the test suite truncates every table in it.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hms_test"

# ---------------------------------------------------------------------------
# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 33)
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-secret"
# Set to true when running behind a trusted proxy / on Vercel.
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Development-only demo seed. The seed script refuses to run unless this is
# "true" and NODE_ENV is not "production".
# ---------------------------------------------------------------------------
ALLOW_DEMO_SEED=false
